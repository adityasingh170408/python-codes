def add_matrix(A, B):
    rows = len(A)
    cols = len(A[0])

    C = []

    for i in range(rows):
        row = []
        for j in range(cols):
            row.append(A[i][j] + B[i][j])
        C.append(row)

    return C

def display_matrix(M):
    for row in M:
        print(row)


# Input first matrix
A = [
    [1, 2],
    [3, 4]
]


B = [
    [5, 6],
    [7, 8]
]


C = add_matrix(A, B)

print("First Matrix:")
display_matrix(A)

print("Second Matrix:")
display_matrix(B)

print("Addition of Two Matrices:")
display_matrix(C)
